#!/bin/sh
# Pre-push hook: block direct pushes to main branch.
# All changes must go through a Pull Request.

remote="$1"
url="$2"

while read local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/main)
      echo "ERROR: Direct push to 'main' is blocked. Open a Pull Request instead."
      echo "GitHub Flow: https://docs.github.com/en/get-started/using-github/github-flow"
      echo "To bypass: git push --no-verify"
      exit 1
      ;;
  esac
done

exit 0
